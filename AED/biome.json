{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/frontend/**/*",
			"**/backend/**/*",
			"**/*.ts",
			"**/*.tsx",
			"!**/node_modules",
			"!**/.output",
			"!**/.tanstack",
			"!**/.claude",
			"!**/.agents",
			"!**/.jcode",
			"!**/skills-lock.json",
			"!**/public",
			"!**/dane.gov.pl",
			"!**/frontend/components",
			"!**/frontend/routeTree.gen.ts",
			"!**/frontend/styles.css",
			"!**/backend/store/drizzle",
			"!**/src/server/ingest",
			"!**/scripts",
			"!**/backend/ingest",
			"!**/data/core"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80,
		"lineEnding": "lf",
		"attributePosition": "auto",
		"bracketSameLine": false,
		"bracketSpacing": true
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"recommended": true
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/src/server/ingest/config/**"],
			"linter": {
				"rules": {
					"complexity": {
						"useLiteralKeys": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"globals": ["Bun"],
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"quoteProperties": "asNeeded"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab"
		},
		"parser": {
			"allowComments": true
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab"
		},
		"linter": {
			"enabled": true
		}
	}
}
