{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aed.local/schemas/dedup-fixture.schema.json",
  "title": "AED dedup evaluation fixture",
  "description": "Fixture pack for identity resolution, blocking, scoring, clustering, merge survivorship and review queue. All records are pre-normalized source records.",
  "type": "object",
  "required": ["version", "suite", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "suite": { "type": "string", "enum": ["identity", "merge", "review"] },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "recordKey": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:.+$",
      "description": "source_id + ':' + source_record_id"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": { "type": "string" },
        "district": { "type": "string" },
        "street": { "type": "string" },
        "house_number": { "type": "string" },
        "postcode": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{3}$" },
        "teryt_commune": { "type": "string" },
        "address_text": { "type": "string" }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "nip": { "type": "string" },
        "regon": { "type": "string" },
        "operator_type": {
          "type": "string",
          "enum": [
            "osp_ksrg",
            "psp",
            "nfz_provider",
            "municipality",
            "school",
            "university",
            "business",
            "ngo",
            "transport_authority",
            "government",
            "other",
            "unknown"
          ]
        },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "serial_number": { "type": "string" },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "device_type": { "type": "string", "enum": ["public_aed", "trainer", "unknown"] },
        "pads_type": { "type": "string", "enum": ["adult", "pediatric", "dual", "unknown"] }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "coord_precision_m": { "type": ["number", "null"], "minimum": 0 },
        "facility_type": {
          "type": "string",
          "enum": [
            "osp_fire_station",
            "psp_fire_station",
            "hospital",
            "clinic",
            "pharmacy",
            "school",
            "university",
            "municipal_office",
            "shopping_mall",
            "hotel",
            "transport_station",
            "airport",
            "sports_venue",
            "workplace",
            "park",
            "public_space",
            "other",
            "unknown"
          ]
        },
        "address": { "$ref": "#/$defs/address" },
        "operator": { "$ref": "#/$defs/operator" },
        "device": { "$ref": "#/$defs/device" },
        "access_type": {
          "type": "string",
          "enum": ["public", "permissive", "customers", "private", "key", "code", "dispatcher", "unknown"]
        },
        "opening_hours": { "type": "string" },
        "is_24_7": { "type": ["boolean", "null"] },
        "requires_dispatcher": { "type": ["boolean", "null"] },
        "status": { "type": "string", "enum": ["active", "out_of_service", "removed", "planned", "unknown"] },
        "verification_method": {
          "type": "string",
          "enum": ["field_survey", "operator", "official_register", "community", "import"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "photo_url": { "type": "string" },
        "license_id": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "required": ["source_id", "source_record_id", "observed_at", "source_tier", "fields"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "source_record_id": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "source_tier": {
          "type": "string",
          "enum": ["authoritative", "official_local", "community", "aggregator", "derived", "app"]
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "source_url": { "type": "string" },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "override": {
      "type": "object",
      "required": ["kind", "reason", "actor"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["force_merge", "do_not_merge", "field_pin", "force_status", "ignore_source", "ignore_field"]
        },
        "a": { "$ref": "#/$defs/recordKey" },
        "b": { "$ref": "#/$defs/recordKey" },
        "cluster": { "type": "integer", "minimum": 0 },
        "field": { "type": "string" },
        "value": {},
        "reason": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "submission": {
      "type": "object",
      "required": ["id", "type", "record_refs", "submitted_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["duplicate_report", "wrong_location", "removed_report"] },
        "record_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recordKey" }
        },
        "note": { "type": "string" },
        "submitted_at": { "type": "string", "format": "date-time" }
      }
    },
    "sourceAnomaly": {
      "type": "object",
      "required": ["source_id", "code", "detail"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string" },
        "code": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "scoreRange": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0, "maximum": 1 },
        "max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "pairDecision": {
      "type": "object",
      "required": ["a", "b", "decision"],
      "additionalProperties": false,
      "properties": {
        "a": { "$ref": "#/$defs/recordKey" },
        "b": { "$ref": "#/$defs/recordKey" },
        "decision": { "type": "string", "enum": ["same_entity", "auto_merge", "review", "separate"] },
        "score": { "$ref": "#/$defs/scoreRange" },
        "hard_conflict": { "type": "boolean", "default": false },
        "forced": { "type": "boolean", "default": false }
      }
    },
    "reviewExpectation": {
      "type": "object",
      "required": ["kind", "severity"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "merge_candidate",
            "cluster_guard",
            "identity_conflict",
            "field_conflict",
            "validation_anomaly",
            "source_anomaly",
            "user_report",
            "split_request"
          ]
        },
        "field_name": { "type": ["string", "null"] },
        "severity": { "type": "string", "enum": ["blocking", "warning", "info"] },
        "record_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/recordKey" }
        }
      }
    },
    "canonicalExpectation": {
      "type": "object",
      "required": ["cluster"],
      "additionalProperties": false,
      "properties": {
        "cluster": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "field name -> record_key or 'manual' or 'no_data'"
        },
        "disputed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "license_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "validationIssue": {
      "type": "object",
      "required": ["record", "code"],
      "additionalProperties": false,
      "properties": {
        "record": { "$ref": "#/$defs/recordKey" },
        "code": {
          "type": "string",
          "enum": [
            "OUT_OF_POLAND",
            "SUSPECTED_AXIS_SWAP",
            "OUT_OF_BOUNDS",
            "MISSING_GEOMETRY",
            "DUPLICATE_LABEL",
            "COORDINATE_OUTLIER"
          ]
        },
        "severity": { "type": "string", "enum": ["blocking", "warning", "info"], "default": "warning" }
      }
    },
    "expected": {
      "type": "object",
      "required": ["clusters"],
      "additionalProperties": false,
      "properties": {
        "clusters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/recordKey" }
          },
          "description": "Sorted by minimum record_key. Inner arrays are sets."
        },
        "facility_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/recordKey" }
          },
          "description": "Sorted by minimum record_key. Inner arrays are sets."
        },
        "pair_decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/pairDecision" }
        },
        "review_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewExpectation" }
        },
        "canonical": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalExpectation" }
        },
        "validation_issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationIssue" }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "tags", "as_of", "records", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "split": { "type": "string", "enum": ["dev", "holdout"], "default": "dev" },
        "as_of": { "type": "string", "format": "date-time" },
        "allow_extra_info": { "type": "boolean", "default": false },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/record" }
        },
        "reimport": {
          "type": "array",
          "items": { "$ref": "#/$defs/record" },
          "description": "Records applied a second time with the same source key. Used to assert upsert idempotency."
        },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/override" }
        },
        "submissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/submission" }
        },
        "source_anomalies": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceAnomaly" }
        },
        "expected": { "$ref": "#/$defs/expected" }
      }
    }
  }
}
