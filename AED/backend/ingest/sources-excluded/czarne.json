{
	"connector": {
		"family": "pdf_table",
		"notes": "Warstwa tekstowa PDF, rekonstrukcja tabeli po współrzędnych x/y. Bez OCR. Kotwica wiersza: komórka lp pasująca do ^\\d+\\.$.",
		"parser": "pdf_table"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": true,
			"max_suspicious_ratio": 0,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 20,
			"schema_fields": [
				"lp",
				"name",
				"address",
				"coords",
				"placement",
				"availability"
			]
		},
		"golden_sample": {
			"required_match_ratio": 1,
			"size": 20
		},
		"quality": {
			"max_coord_invalid_ratio": 0,
			"max_duplicate_id_ratio": 0,
			"max_null_ratio": {
				"lat": 0,
				"lon": 0,
				"name": 0
			},
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "review",
			"on_missing_field": "fail",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.25,
			"min_records": 18,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 4
		},
		"retries": {
			"backoff_ms": 2000,
			"max": 2
		},
		"timeout_ms": 45000,
		"url": "https://czarne.pl/files/file_add/download/35_document.pdf",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"map": {
		"access_type": {
			"else": "private",
			"then": "public",
			"when": {
				"left": {
					"field": "availability"
				},
				"op": "regex",
				"right": "24h"
			}
		},
		"address_text": {
			"field": "address"
		},
		"city": {
			"regex": {
				"in": {
					"field": "address"
				},
				"pattern": "^([^\\s,]+)"
			}
		},
		"confidence": {
			"const": 0.85
		},
		"coord_precision_m": {
			"const": 15
		},
		"country_code": {
			"const": "PL"
		},
		"description": {
			"field": "placement"
		},
		"device_type": {
			"const": "public_aed"
		},
		"entrance_description": {
			"field": "placement"
		},
		"facility_type": {
			"else": {
				"else": {
					"else": {
						"else": "unknown",
						"then": "sports_venue",
						"when": {
							"left": {
								"field": "name"
							},
							"op": "regex",
							"right": "(?i)Boisko"
						}
					},
					"then": "school",
					"when": {
						"left": {
							"field": "name"
						},
						"op": "regex",
						"right": "(?i)Szkoła"
					}
				},
				"then": "municipal_office",
				"when": {
					"left": {
						"field": "name"
					},
					"op": "regex",
					"right": "(?i)Urząd Miasta"
				}
			},
			"then": "osp_fire_station",
			"when": {
				"left": {
					"field": "name"
				},
				"op": "regex",
				"right": "(?i)Ochotnicza Straż Pożarna"
			}
		},
		"indoor": {
			"else": {
				"else": null,
				"then": false,
				"when": {
					"left": {
						"field": "placement"
					},
					"op": "regex",
					"right": "(?i)^Na zewnątrz"
				}
			},
			"then": true,
			"when": {
				"left": {
					"field": "placement"
				},
				"op": "regex",
				"right": "(?i)^Wewnątrz"
			}
		},
		"is_24_7": {
			"else": false,
			"then": true,
			"when": {
				"left": {
					"field": "availability"
				},
				"op": "regex",
				"right": "24h"
			}
		},
		"label": {
			"template": "czarne:{lp}"
		},
		"last_verified_at": {
			"const": null
		},
		"lat": {
			"coord": {
				"axis_policy": "declared",
				"delimiter": ",",
				"format": "pair",
				"from": {
					"field": "coords"
				},
				"on_invalid": "review",
				"order": "lat_lon",
				"pick": "lat",
				"precision_m": 15
			}
		},
		"lon": {
			"coord": {
				"axis_policy": "declared",
				"delimiter": ",",
				"format": "pair",
				"from": {
					"field": "coords"
				},
				"on_invalid": "review",
				"order": "lat_lon",
				"pick": "lon",
				"precision_m": 15
			}
		},
		"name": {
			"field": "name"
		},
		"note": {
			"field": "placement"
		},
		"opening_hours": {
			"else": {
				"field": "availability"
			},
			"then": null,
			"when": {
				"left": {
					"field": "availability"
				},
				"op": "regex",
				"right": "24h"
			}
		},
		"operator_name": {
			"const": "Gmina Czarne"
		},
		"operator_type": {
			"const": "municipality"
		},
		"source_updated_at": {
			"const": "2026-02-19"
		},
		"source_url": {
			"const": "https://czarne.pl/files/file_add/download/35_document.pdf"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"pdf_table": {
			"collapse_whitespace": true,
			"columns": [
				{
					"key": "lp",
					"x_max": 55,
					"x_min": 0
				},
				{
					"key": "name",
					"x_max": 205,
					"x_min": 55
				},
				{
					"key": "address",
					"x_max": 315,
					"x_min": 205
				},
				{
					"key": "coords",
					"x_max": 425,
					"x_min": 315
				},
				{
					"key": "placement",
					"x_max": 500,
					"x_min": 425
				},
				{
					"key": "availability",
					"x_max": 596,
					"x_min": 500
				}
			],
			"empty_as_null": true,
			"expected_page_count": 1,
			"max_records": 20,
			"min_records": 20,
			"min_text_chars": 500,
			"multi_line": "join_space",
			"pages": [
				1
			],
			"require_text_layer": true,
			"row_anchor": {
				"column": "lp",
				"regex": "^\\d+\\.$"
			},
			"row_tolerance": 2.5,
			"strategy": "word_positions",
			"trim": true
		},
		"trim_headers": false
	},
	"publish": {
		"attribution": "Gmina Czarne — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": []
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "lp"
				}
			],
			"on_duplicate": "reject"
		},
		"identity": {
			"dataset_id": {
				"const": "czarne:pdf:aed"
			},
			"source_record_id": {
				"template": "czarne:{lp}"
			},
			"stable": true
		},
		"path": "$"
	},
	"source": {
		"access_type": "file",
		"coverage": {
			"country": "PL",
			"notes": "Gmina miejsko-wiejska Czarne, pomorskie (TERYT 2203023). 20 punktów w jednej tabeli PDF, wszystkie ze współrzędnymi WGS84."
		},
		"enabled": false,
		"homepage_url": "https://czarne.pl/files/file_add/download/35_document.pdf",
		"id": "czarne",
		"license": {
			"attribution": "Gmina Czarne — https://czarne.pl/files/file_add/download/35_document.pdf (brak deklaracji licencji)",
			"id": "NOASSERTION"
		},
		"name": "Lokalizacje defibrylatorów AED w gminie Czarne",
		"notes": "Klasa B+ z audytu JST. Live check 2026-11-21: HTTP 200, application/download, sygnatura %PDF, PDF 1.7, 1 strona, warstwa tekstowa. Nagłówek tabeli: lp., Nazwa obiektu, Adres, Współrzędne geograficzne, Umieszczenie AED, Uwagi. Kolumny są wielowierszowe i nie są wyrównane do jednej linii bazowej, dlatego wymagana jest rekonstrukcja po pozycjach słów i kotwicy lp. Do czasu wdrożenia parsera pdf_table config pozostaje wyłączony.",
		"publisher": "Gmina Czarne",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				16.88,
				53.58,
				17.18,
				53.72
			],
			"on_invalid": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "point",
		"required": [
			"name",
			"lat",
			"lon"
		]
	},
	"version": 1
}
