{
	"connector": {
		"family": "html_table",
		"notes": "BLOCKED — brak tabeli z listą AED. Konfiguracja zachowana jako kontener na przyszły parser; select table daje 0 rekordów.",
		"parser": "html_table"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 0
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 1,
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "review",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 1,
			"min_records": 0,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://typo3.um.bydgoszcz.pl/bezpieczenstwo/abc-bezpieczenstwa",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, {city}",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": true,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "structured_first"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"field": "address"
		},
		"city": {
			"const": "Bydgoszcz"
		},
		"confidence": {
			"const": 0.2
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"name": {
			"field": "name"
		},
		"operator_name": {
			"const": "Miasto Bydgoszcz"
		},
		"operator_type": {
			"const": "municipality"
		},
		"source_updated_at": {
			"const": null
		},
		"source_url": {
			"const": "https://typo3.um.bydgoszcz.pl/bezpieczenstwo/abc-bezpieczenstwa"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_table": {
			"collapse_whitespace": true,
			"data_start_row": 1,
			"empty_as_null": true,
			"header_row": 0,
			"max_records": 0,
			"min_records": 0,
			"normalize_headers": true,
			"orientation": "rows",
			"select": "table",
			"skip_empty_rows": true,
			"table_index": 0,
			"trim": true
		},
		"trim_headers": true
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Miasto Bydgoszcz — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": []
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "address"
				}
			],
			"on_duplicate": "warn"
		},
		"identity": {
			"dataset_id": {
				"const": "bydgoszcz:html:aed"
			},
			"source_record_id": {
				"template": "bydgoszcz:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "Miasto Bydgoszcz, kujawsko-pomorskie. Inwentarz deklaruje 114 adresów, ale strona nie publikuje ich w HTML.",
			"teryt": [
				"0461011"
			]
		},
		"enabled": false,
		"homepage_url": "https://typo3.um.bydgoszcz.pl/bezpieczenstwo/abc-bezpieczenstwa",
		"id": "bydgoszcz",
		"license": {
			"attribution": "Miasto Bydgoszcz — https://typo3.um.bydgoszcz.pl/bezpieczenstwo/abc-bezpieczenstwa (brak deklaracji licencji)",
			"id": "NOASSERTION"
		},
		"name": "Automatyczne Defibrylatory Zewnętrzne (AED) w Bydgoszczy",
		"notes": "BLOCKED: sekcja VI 'Automatyczne Defibrylatory Zewnętrzne (AED) w Bydgoszczy' to wyłącznie iframe Google My Maps (mid=1_gVCuQGcZRIviaAxxvbjC02u33s). Brak tabeli/listy adresów w HTML. Wymagany KML/CSV albo ręczne wydobycie z mapy; nie zgadujemy selektora.",
		"publisher": "Miasto Bydgoszcz",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				17.85,
				53.08,
				18.15,
				53.18
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
