{
	"connector": {
		"family": "html_list",
		"notes": "Selektor div.col-lg-9 p + filtr nazw instytucji; cały tekst akapitu jest nazwą i adresem.",
		"parser": "html_list"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 0.1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 21,
			"schema_fields": [
				"text"
			]
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 0.1,
			"max_null_ratio": {
				"address_text": 0,
				"name": 0
			},
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "fail",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.5,
			"min_records": 18,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://polkowice.eu/defibrylator-ratuje-zycie/",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, Polkowice",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": false,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "unstructured_first"
	},
	"map": {
		"access_type": {
			"const": "public"
		},
		"address_text": {
			"field": "text"
		},
		"city": {
			"const": "Polkowice"
		},
		"confidence": {
			"const": 0.5
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"facility_type": {
			"else": {
				"else": {
					"else": "unknown",
					"then": "municipal_office",
					"when": {
						"left": {
							"field": "text"
						},
						"op": "regex",
						"right": "(?i)Urząd Gminy|Starostwo"
					}
				},
				"then": "osp_fire_station",
				"when": {
					"left": {
						"field": "text"
					},
					"op": "regex",
					"right": "(?i)Remiza OSP"
				}
			},
			"then": "school",
			"when": {
				"left": {
					"field": "text"
				},
				"op": "regex",
				"right": "(?i)Szkoła"
			}
		},
		"is_24_7": {
			"const": null
		},
		"label": {
			"template": "polkowice:{row_index}"
		},
		"last_verified_at": {
			"const": null
		},
		"name": {
			"field": "text"
		},
		"operator_name": {
			"const": "Gmina Polkowice"
		},
		"operator_type": {
			"const": "municipality"
		},
		"source_updated_at": {
			"const": "2026-01-07"
		},
		"source_url": {
			"const": "https://polkowice.eu/defibrylator-ratuje-zycie/"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_list": {
			"collapse_whitespace": true,
			"empty_as_null": true,
			"item_text_separator": " ",
			"max_records": 23,
			"min_records": 21,
			"record_filter": {
				"regex": "^(Urząd Gminy|Miejsko-Gminna|Ośrodek Pomocy|Centrum Kultury|Szkoła Podstawowa|Polkowickie|Uczelnia|Przedsiębiorstwo|Aquapark|Remiza OSP|Straż Miejska|Starostwo Powiatowe)"
			},
			"select": "div.col-lg-9 p",
			"trim": true
		},
		"trim_headers": false
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Gmina Polkowice — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": []
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "text"
				}
			],
			"on_duplicate": "warn"
		},
		"identity": {
			"dataset_id": {
				"const": "polkowice:html:aed"
			},
			"source_record_id": {
				"template": "polkowice:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "Gmina miejsko-wiejska Polkowice, dolnośląskie. 21 miejsc / 23 urządzenia; część wpisów bez numeru ulicy.",
			"teryt": [
				"0216043"
			]
		},
		"enabled": false,
		"homepage_url": "https://polkowice.eu/defibrylator-ratuje-zycie/",
		"id": "polkowice",
		"license": {
			"attribution": "Gmina Polkowice — https://polkowice.eu/defibrylator-ratuje-zycie/ (brak deklaracji licencji)",
			"id": "NOASSERTION"
		},
		"name": "Defibrylatory AED w Gminie Polkowice",
		"notes": "21 akapitów lokalizacji w div.col-lg-9, filtrowanych po nazwach obiektów; sprawdzone live 2026-11-21. Część adresów to sama nazwa instytucji, więc geokodowanie będzie częściowo nieprecyzyjne.",
		"publisher": "Gmina Polkowice",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				15.95,
				51.45,
				16.15,
				51.58
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address_or_point",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
