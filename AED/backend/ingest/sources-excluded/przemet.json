{
	"connector": {
		"family": "html_list",
		"notes": "Lista `<ol>` w `div.entry-content` ma 21 pozycji; każda zawiera adres przed myślnikiem i opis kapsuły po myślniku. 21 wpisów odpowiada ok. 20 lokalizacjom (dwa wpisy dla Przemęt, ul. Jagiellońska 8).",
		"parser": "html_list"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 0.1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 21
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 0.1,
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "review",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.5,
			"min_records": 21,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://www.przemet.pl/2025,02,wykaz-aed/",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, {city}",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": true,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "structured_first"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"coalesce": [
				{
					"field": "address"
				},
				{
					"field": "text"
				}
			]
		},
		"city": {
			"const": "Przemęt"
		},
		"confidence": {
			"const": 0.3
		},
		"country_code": {
			"const": "PL"
		},
		"facility_type": {
			"const": "unknown"
		},
		"name": {
			"field": "address"
		},
		"source_url": {
			"const": "https://www.przemet.pl/2025,02,wykaz-aed/"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_list": {
			"collapse_whitespace": true,
			"empty_as_null": true,
			"fields": {
				"address": {
					"group": 1,
					"regex": "^([^–]+?)\\s+–"
				}
			},
			"max_records": 25,
			"min_records": 21,
			"record_filter": {
				"regex": "\\s+–\\s+"
			},
			"select": "li",
			"trim": true
		},
		"trim_headers": true
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Przemęt — NOASSERTION",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION"
	},
	"records": {
		"identity": {
			"source_record_id": {
				"template": "przemet:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "wielkopolskie; gmina miejsko-wiejska; 21 wpisów / 20 lokalizacji; lista 24/7; część pozycji ma link Google Maps ze współrzędnymi. 21 wpisów / 20 lokalizacji; lista 24/7; częściowo linki Google Maps.",
			"teryt": [
				"3029012"
			]
		},
		"enabled": false,
		"homepage_url": "https://www.przemet.pl/2025,02,wykaz-aed/",
		"id": "przemet",
		"license": {
			"attribution": "Przemęt: brak deklaracji licencji",
			"id": "NOASSERTION"
		},
		"name": "Przemęt",
		"notes": "21 wpisów / 20 lokalizacji; lista 24/7; część pozycji ma link Google Maps ze współrzędnymi. 21 wpisów / 20 lokalizacji; lista 24/7; częściowo linki Google Maps.",
		"publisher": "Przemęt",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				14.07,
				49,
				24.15,
				54.84
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address_or_point",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
