{
	"connector": {
		"family": "html_table",
		"notes": "Jedna tabela z 5 kolumnami i 25 wierszami danych. Nagłówek: Lp, Nazwa instytucji, Adres, Lokalizacja AED, Dostępność. Część wierszy opisuje kilka urządzeń w jednym budynku; to jeden rekord na instytucję.",
		"parser": "html_table"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 0.1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 25
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 0.1,
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "review",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.5,
			"min_records": 25,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://www.slupsk.pl/mieszkaniec/zdrowie-i-sprawy-spoleczne/defibrylatory-aed",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, {city}",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": true,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "structured_first"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"coalesce": [
				{
					"regex": {
						"group": 1,
						"in": {
							"field": "address"
						},
						"pattern": "^(.*?)(\\d{2}-\\d{3}).*$"
					}
				},
				{
					"field": "address"
				}
			]
		},
		"city": {
			"const": "Słupsk"
		},
		"confidence": {
			"const": 0.3
		},
		"country_code": {
			"const": "PL"
		},
		"facility_type": {
			"const": "unknown"
		},
		"name": {
			"field": "name"
		},
		"source_url": {
			"const": "https://www.slupsk.pl/mieszkaniec/zdrowie-i-sprawy-spoleczne/defibrylatory-aed"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_table": {
			"collapse_whitespace": true,
			"columns": [
				"lp",
				"name",
				"address",
				"location",
				"access"
			],
			"data_start_row": 1,
			"empty_as_null": true,
			"header_row": 0,
			"max_records": 30,
			"min_records": 25,
			"normalize_headers": true,
			"orientation": "rows",
			"select": "table",
			"table_index": 0,
			"trim": true
		},
		"trim_headers": true
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Słupsk — NOASSERTION",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION"
	},
	"records": {
		"identity": {
			"source_record_id": {
				"template": "slupsk:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "pomorskie; miasto; 25 wierszy tabeli; część wierszy opisuje kilka urządzeń w jednym budynku. 25 wierszy; część wierszy opisuje kilka urządzeń w jednym budynku.",
			"teryt": [
				"2263011"
			]
		},
		"enabled": false,
		"homepage_url": "https://www.slupsk.pl/mieszkaniec/zdrowie-i-sprawy-spoleczne/defibrylatory-aed",
		"id": "slupsk",
		"license": {
			"attribution": "Słupsk: brak deklaracji licencji",
			"id": "NOASSERTION"
		},
		"name": "Słupsk",
		"notes": "25 wierszy tabeli; część wierszy opisuje kilka urządzeń w jednym budynku. 25 wierszy; część wierszy opisuje kilka urządzeń w jednym budynku.",
		"publisher": "Słupsk",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				14.07,
				49,
				24.15,
				54.84
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address_or_point",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
