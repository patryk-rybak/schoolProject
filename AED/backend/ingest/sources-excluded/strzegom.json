{
	"connector": {
		"family": "html_list",
		"notes": "Selektor div.gov17-news-body ol li; nazwa obiektu przed nawiasem, liczba sztuk w nawiasie/po tekście.",
		"parser": "html_list"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 0.1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 15,
			"schema_fields": [
				"text",
				"name",
				"placement",
				"device_count"
			]
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 0.1,
			"max_null_ratio": {
				"address_text": 0,
				"name": 0
			},
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "fail",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.5,
			"min_records": 12,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://strzegom.pl/aktualnosci/n,406305,wykaz-defibrylatorow-aed-na-terenie-gminy-strzegom.html",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, Strzegom",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": false,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "unstructured_first"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"field": "name"
		},
		"city": {
			"const": "Strzegom"
		},
		"confidence": {
			"const": 0.5
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"facility_type": {
			"else": {
				"else": {
					"else": "unknown",
					"then": "school",
					"when": {
						"left": {
							"field": "name"
						},
						"op": "regex",
						"right": "(?i)ZESPÓŁ SZKÓŁ|SZKOŁA"
					}
				},
				"then": "municipal_office",
				"when": {
					"left": {
						"field": "name"
					},
					"op": "regex",
					"right": "(?i)URZĄD MIEJSKI"
				}
			},
			"then": "osp_fire_station",
			"when": {
				"left": {
					"field": "name"
				},
				"op": "regex",
				"right": "(?i)OSP"
			}
		},
		"is_24_7": {
			"const": null
		},
		"label": {
			"template": "strzegom:{row_index}"
		},
		"last_verified_at": {
			"const": null
		},
		"name": {
			"field": "name"
		},
		"operator_name": {
			"const": "Gmina Strzegom"
		},
		"operator_type": {
			"const": "municipality"
		},
		"source_updated_at": {
			"const": "2024-09-27"
		},
		"source_url": {
			"const": "https://strzegom.pl/aktualnosci/n,406305,wykaz-defibrylatorow-aed-na-terenie-gminy-strzegom.html"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_list": {
			"collapse_whitespace": true,
			"empty_as_null": true,
			"fields": {
				"device_count": {
					"group": 1,
					"regex": "(\\d+)\\s*szt"
				},
				"name": {
					"group": 1,
					"regex": "^(.+?)\\s*\\("
				},
				"placement": {
					"group": 1,
					"regex": "\\(([^()]*)\\)"
				}
			},
			"item_text_separator": " ",
			"max_records": 19,
			"min_records": 15,
			"select": "div.gov17-news-body ol li",
			"trim": true
		},
		"trim_headers": false
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Gmina Strzegom — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": []
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "name"
				}
			],
			"on_duplicate": "warn"
		},
		"identity": {
			"dataset_id": {
				"const": "strzegom:html:aed"
			},
			"source_record_id": {
				"template": "strzegom:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "Gmina miejsko-wiejska Strzegom, dolnośląskie. 15 miejsc / 19 urządzeń, bez współrzędnych.",
			"teryt": [
				"0219063"
			]
		},
		"enabled": false,
		"homepage_url": "https://strzegom.pl/aktualnosci/n,406305,wykaz-defibrylatorow-aed-na-terenie-gminy-strzegom.html",
		"id": "strzegom",
		"license": {
			"attribution": "Gmina Strzegom — https://strzegom.pl/aktualnosci/n,406305,wykaz-defibrylatorow-aed-na-terenie-gminy-strzegom.html (brak deklaracji licencji)",
			"id": "NOASSERTION"
		},
		"name": "Wykaz defibrylatorów AED w Gminie Strzegom",
		"notes": "Lista <ol> w div.gov17-news-body ma 15 pozycji; sprawdzone live 2026-11-21. Wpisy to nazwy obiektów (OSP, świetlice, urząd), nie pełne adresy, więc geokodowanie będzie przybliżone lub nieudane.",
		"publisher": "Gmina Strzegom",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				16.45,
				50.9,
				16.65,
				51.05
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address_or_point",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
