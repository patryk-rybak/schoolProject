{
	"connector": {
		"family": "html_table",
		"notes": "Tabela article-map-points__table, wiersze Nazwa/Kategoria/Mapa. Nazwa zawiera też adres.",
		"parser": "html_table"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 0.1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 20,
			"schema_fields": [
				"Nazwa",
				"Kategoria",
				"Mapa"
			]
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 0.1,
			"max_null_ratio": {
				"address_text": 0,
				"name": 0
			},
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "review",
			"on_missing_field": "fail",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.5,
			"min_records": 18,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://krakow.pl/aed_-_impuls_zycia/3992,artykul,mapa_aed.html",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, Kraków",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": false,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "unstructured_first"
	},
	"map": {
		"access_type": {
			"const": "public"
		},
		"address_text": {
			"field": "Nazwa"
		},
		"city": {
			"const": "Kraków"
		},
		"confidence": {
			"const": 0.55
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"facility_type": {
			"const": "unknown"
		},
		"is_24_7": {
			"const": null
		},
		"label": {
			"template": "krakow:{row_index}"
		},
		"last_verified_at": {
			"const": null
		},
		"name": {
			"field": "Nazwa"
		},
		"operator_name": {
			"const": "Miasto Kraków"
		},
		"operator_type": {
			"const": "municipality"
		},
		"source_updated_at": {
			"const": null
		},
		"source_url": {
			"const": "https://krakow.pl/aed_-_impuls_zycia/3992,artykul,mapa_aed.html"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_table": {
			"collapse_whitespace": true,
			"columns": [
				"Nazwa",
				"Kategoria",
				"Mapa"
			],
			"data_start_row": 1,
			"empty_as_null": true,
			"header_row": 0,
			"max_records": 74,
			"min_records": 20,
			"normalize_headers": true,
			"orientation": "rows",
			"select": "table.article-map-points__table",
			"skip_empty_rows": true,
			"table_index": 0,
			"trim": true
		},
		"trim_headers": true
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Miasto Kraków — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": []
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "Nazwa"
				}
			],
			"on_duplicate": "warn"
		},
		"identity": {
			"dataset_id": {
				"const": "krakow:html:aed"
			},
			"source_record_id": {
				"template": "krakow:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "Miasto Kraków, małopolskie. Tabela z 20 wierszami na pierwszej stronie; inwentarz deklaruje 58 w tabeli (20/20/18).",
			"teryt": [
				"1261011"
			]
		},
		"enabled": false,
		"homepage_url": "https://krakow.pl/aed_-_impuls_zycia/3992,artykul,mapa_aed.html",
		"id": "krakow",
		"license": {
			"attribution": "Miasto Kraków — https://krakow.pl/aed_-_impuls_zycia/3992,artykul,mapa_aed.html (brak deklaracji licencji)",
			"id": "NOASSERTION"
		},
		"name": "Mapa AED — Kraków",
		"notes": "Tabela article-map-points__table ma 20 wierszy danych w statycznym HTML; sprawdzone live 2026-11-21. Paginacja jest path-based: /instcbi/3992/2432/{0..3}/ daje 20/20/20/18 = 78 unikalnych rekordów. Config pobiera tylko dokument bazowy, więc baseline to 20; pełny zbiór wymaga przyszłego wsparcia paginacji path. Kolumna Mapa jest pusta.",
		"publisher": "Miasto Kraków",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				19.75,
				49.95,
				20.15,
				50.15
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address_or_point",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
