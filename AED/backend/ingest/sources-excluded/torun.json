{
	"connector": {
		"family": "html_list",
		"notes": "Selektor div.field__item ol li; nazwa przed typem ulicy, adres od 'ul.'/'Plac'/'al.'.",
		"parser": "html_list"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 0.1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 46,
			"schema_fields": [
				"text",
				"name",
				"address"
			]
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 0.1,
			"max_null_ratio": {
				"address_text": 0,
				"name": 0
			},
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "fail",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.25,
			"min_records": 40,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://www.torun.pl/pl/zdrowie/defibrylatory-aed-wykaz-lokalizacji",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, Toruń",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": false,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "structured_first"
	},
	"map": {
		"access_type": {
			"const": "public"
		},
		"address_text": {
			"field": "address"
		},
		"city": {
			"const": "Toruń"
		},
		"confidence": {
			"const": 0.6
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"facility_type": {
			"else": {
				"else": {
					"else": "unknown",
					"then": "fire_station",
					"when": {
						"left": {
							"field": "name"
						},
						"op": "regex",
						"right": "(?i)Straż Pożarna"
					}
				},
				"then": "municipal_office",
				"when": {
					"left": {
						"field": "name"
					},
					"op": "regex",
					"right": "(?i)Urząd Miasta"
				}
			},
			"then": "school",
			"when": {
				"left": {
					"field": "name"
				},
				"op": "regex",
				"right": "(?i)Szkoła|Liceum|Muzyczna"
			}
		},
		"is_24_7": {
			"const": null
		},
		"label": {
			"template": "torun:{row_index}"
		},
		"last_verified_at": {
			"const": null
		},
		"name": {
			"field": "name"
		},
		"operator_name": {
			"const": "Gmina Miasta Toruń"
		},
		"operator_type": {
			"const": "municipality"
		},
		"source_updated_at": {
			"const": null
		},
		"source_url": {
			"const": "https://www.torun.pl/pl/zdrowie/defibrylatory-aed-wykaz-lokalizacji"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_list": {
			"collapse_whitespace": true,
			"empty_as_null": true,
			"fields": {
				"address": {
					"group": 1,
					"regex": "((?:ul\\.|Plac|pl\\.|al\\.|Aleja)\\s.*)$"
				},
				"name": {
					"group": 1,
					"regex": "^(.+?)\\s+(?:ul\\.|Plac|pl\\.|al\\.|Aleja)\\s"
				}
			},
			"item_text_separator": " ",
			"max_records": 100,
			"min_records": 46,
			"select": "div.field__item ol li",
			"trim": true
		},
		"trim_headers": false
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Gmina Miasta Toruń — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": []
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "name"
				},
				{
					"field": "address"
				}
			],
			"on_duplicate": "warn"
		},
		"identity": {
			"dataset_id": {
				"const": "torun:html:aed"
			},
			"source_record_id": {
				"template": "torun:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "Miasto Toruń, kujawsko-pomorskie. 46 pozycji z nazwą obiektu i adresem, bez współrzędnych.",
			"teryt": [
				"0463011"
			]
		},
		"enabled": false,
		"homepage_url": "https://www.torun.pl/pl/zdrowie/defibrylatory-aed-wykaz-lokalizacji",
		"id": "torun",
		"license": {
			"attribution": "Gmina Miasta Toruń — https://www.torun.pl/pl/zdrowie/defibrylatory-aed-wykaz-lokalizacji (brak deklaracji licencji)",
			"id": "NOASSERTION"
		},
		"name": "Defibrylatory AED. Wykaz lokalizacji — Toruń",
		"notes": "Lista <ol> w div.field__item ma 46 unikalnych pozycji; sprawdzone live 2026-11-21. Strona powtarza ten sam blok w dwóch zagnieżdżonych kontenerach field__item, więc parser może zwrócić do 92 węzłów przed dedupe po nazwie i adresie. Każda pozycja to <strong>nazwa</strong><br>adres, więc separator elementu musi być spacją.",
		"publisher": "Gmina Miasta Toruń",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				18.45,
				52.96,
				18.75,
				53.09
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address_or_point",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
