{
	"connector": {
		"family": "html_list",
		"notes": "Artykuł to proza. div.text p wymienia trzy DPS (Karniowice, Owczary, Czerna) w dwóch akapitach; parser daje 2 wiersze, bo trzeciej placówki nie da się rozdzielić bez redakcji tekstu.",
		"parser": "html_list"
	},
