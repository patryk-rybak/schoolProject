			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_list": {
			"collapse_whitespace": true,
			"empty_as_null": true,
			"fields": {
				"address_text": {
					"group": 1,
					"regex": "DPS\\s+(?:w\\s+)?(Karniowicach|Karniowice|Owczarach|Owczary|Czernej|Czerna)"
				},
				"name": {
					"group": 1,
					"regex": "DPS\\s+(?:w\\s+)?(Karniowicach|Karniowice|Owczarach|Owczary|Czernej|Czerna)"
				}
			},
			"item_text_separator": " ",
			"max_records": 4,
			"min_records": 1,
			"record_filter": {
				"regex": "DPS"
			},
			"select": "div.text p",
			"trim": true
		},
		"trim_headers": true
	},
