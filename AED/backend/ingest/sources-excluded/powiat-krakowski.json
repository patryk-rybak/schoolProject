	},
	"geocoding": {
		"address_template": "{address_text}, Polska",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": true,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"address_text"
		],
		"strategy": "unstructured_first"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"field": "address_text"
		},
		"city": {
			"const": "powiat krakowski"
		},
		"confidence": {
			"const": 0.3
		},
		"country_code": {
			"const": "PL"
		},
		"facility_type": {
			"const": "unknown"
		},
		"name": {
			"field": "Nazwa"
		},
		"source_url": {
			"const": "https://powiat.krakow.pl/aktualnosci-i-ogloszenia/aktualnosci/nowe-defibrylatory-aed-w-domach-pomocy-spolecznej-w-powiecie-krakowskim"
		},
