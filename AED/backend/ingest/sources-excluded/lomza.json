{
	"connector": {
		"family": "html_table",
		"notes": "BLOCKED — brak tabeli AED na stronie wskazanej w inwentarzu.",
		"parser": "html_table"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 0
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 1,
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "review",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 1,
			"min_records": 0,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://www.lomza.pl/",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, {city}",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": true,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "structured_first"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"field": "address"
		},
		"city": {
			"const": "Łomża"
		},
		"confidence": {
			"const": 0.2
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"name": {
			"field": "name"
		},
		"operator_name": {
			"const": "Miasto Łomża"
		},
		"operator_type": {
			"const": "municipality"
		},
		"source_updated_at": {
			"const": null
		},
		"source_url": {
			"const": "https://www.lomza.pl/"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_table": {
			"collapse_whitespace": true,
			"data_start_row": 1,
			"empty_as_null": true,
			"header_row": 0,
			"max_records": 0,
			"min_records": 0,
			"normalize_headers": true,
			"orientation": "rows",
			"select": "table.aed-wykaz",
			"skip_empty_rows": true,
			"table_index": 0,
			"trim": true
		},
		"trim_headers": true
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Miasto Łomża — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": []
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "address"
				}
			],
			"on_duplicate": "warn"
		},
		"identity": {
			"dataset_id": {
				"const": "lomza:html:aed"
			},
			"source_record_id": {
				"template": "lomza:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "Miasto Łomża, podlaskie. Inwentarz deklaruje 10 lokalizacji w artykułach oficjalnych, bez współrzędnych.",
			"teryt": [
				"2062011"
			]
		},
		"enabled": false,
		"homepage_url": "https://www.lomza.pl/",
		"id": "lomza",
		"license": {
			"attribution": "Miasto Łomża — https://www.lomza.pl/ (brak deklaracji licencji)",
			"id": "NOASSERTION"
		},
		"name": "Defibrylatory AED w Łomży",
		"notes": "BLOCKED 2026-11-21: strona główna nie ma wykazu AED; artykuł index.php?wiad=14106 (2026-03-10) podaje 5 lokalizacji w jednym akapicie, bez tabeli/listy i bez współrzędnych. Selektor `table.aed-wykaz` celowo nie pasuje do kalendarza na stronie głównej. Wymagana transkrypcja lub przyszły parser tekstu liniowego.",
		"publisher": "Miasto Łomża",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				21.95,
				53.12,
				22.15,
				53.24
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
