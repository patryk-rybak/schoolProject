{
  "version": 1,
  "source": {
    "id": "kml-bydgoszcz",
    "name": "AED w Bydgoszczy - lista adresowa bez geometrii punktowej (KML)",
    "publisher": "Miasto Bydgoszcz",
    "homepage_url": "https://typo3.um.bydgoszcz.pl/bezpieczenstwo/abc-bezpieczenstwa",
    "access_type": "kml",
    "reliability_tier": "official_local",
    "license": {
      "id": "NOASSERTION",
      "url": "https://www.google.com/intl/pl/maps/terms.html",
      "attribution": "Mapa Google My Maps Miasta Bydgoszcz; brak deklaracji licencji",
      "share_alike": false
    },
    "coverage": {
      "country": "PL",
      "teryt": ["046101"],
      "notes": "Probe 2026-11-21: 114 placemarków, w tym 111 bez geometrii, 1 Point, 1 LineString, 1 Polygon. To lista adresowa (name, address, NR, INSTYTUCJA), nie mapa punktowa AED."
    },
    "update_frequency": "unknown",
    "enabled": false,
    "notes": "KML bez geometrii nie może utworzyć rekordów aed. Config jest guardem: odrzuca 111 adresów bez coordinates oraz geometrie niepunktowe, zostawia 1 Point. Próg volume.min_records=5 celowo nie przechodzi, więc przebieg kończy się fail i nie publikuje pojedynczego punktu. Listę adresową traktuj jako wejście do geokodowania, nie jako źródło AED."
  },
  "connector": {
    "family": "google_my_maps_kml",
    "parser": "kml",
    "notes": "Punktowy KML z twardym require_coordinates; ExtendedData.NR i INSTYTUCJA zachowane w payloadzie."
  },
  "fetch": {
    "url": "https://www.google.com/maps/d/kml?mid=1_gVCuQGcZRIviaAxxvbjC02u33s&forcekml=1",
    "method": "GET",
    "timeout_ms": 30000,
    "retries": { "max": 2, "backoff_ms": 2000 },
    "rate_limit": { "requests_per_minute": 6 },
    "conditional": { "etag": false, "last_modified": false },
    "pagination": { "type": "none" },
    "user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
  },
  "parse": {
    "encoding": "utf-8",
    "kml": {
      "point_only": true,
      "document_name_must_match": "AED w Bydgoszczy",
      "require_coordinates": true,
      "on_missing_geometry": "reject",
      "on_non_point_geometry": "reject",
      "min_point_ratio": 1.0,
      "on_low_point_ratio": "review",
      "extended_data_as_object": true,
      "strip_cdata": true,
      "description_format": "html"
    }
  },
  "records": {
    "path": "//Placemark",
    "identity": {
      "source_record_id": {
        "template": "{source_id}:kml:{digest}",
        "vars": {
          "source_id": { "builtin": "source_id" },
          "digest": {
            "func": "stable_hash",
            "args": [
              { "field": "name" },
              { "const": "|" },
              { "field": "address" },
              { "const": "|" },
              { "field": "ExtendedData.NR" },
              { "const": "|" },
              { "field": "ExtendedData.INSTYTUCJA" }
            ]
          }
        }
      },
      "dataset_id": { "const": "google-my-maps:1_gVCuQGcZRIviaAxxvbjC02u33s" },
      "stable": false
    },
    "dedupe": {
      "key": [{ "field": "name" }, { "field": "address" }],
      "keep": "first",
      "on_duplicate": "warn"
    }
  },
  "map": {
    "name": { "field": "name" },
    "address_text": { "field": "address" },
    "description": { "func": "strip_html", "args": [{ "field": "description" }] },
    "note": {
      "template": "NR: {nr}; INSTYTUCJA: {instytucja}",
      "vars": {
        "nr": { "field": "ExtendedData.NR" },
        "instytucja": { "field": "ExtendedData.INSTYTUCJA" }
      }
    },
    "facility_type": { "const": "unknown" },
    "device_type": { "const": "public_aed" },
    "lat": { "coord": { "from": "coordinates", "format": "kml", "pick": "lat", "precision_m": 15, "on_invalid": "reject" } },
    "lon": { "coord": { "from": "coordinates", "format": "kml", "pick": "lon", "precision_m": 15, "on_invalid": "reject" } },
    "coord_precision_m": { "const": 15 },
    "country_code": { "const": "PL" },
    "city": { "const": "Bydgoszcz" },
    "access_type": { "const": "unknown" },
    "status": { "const": "unknown" },
    "verification_status": { "const": "candidate" },
    "confidence": { "const": 0.35 },
    "source_url": { "const": "https://typo3.um.bydgoszcz.pl/bezpieczenstwo/abc-bezpieczenstwa" }
  },
  "validate": {
    "required": ["name", "lat", "lon"],
    "coords": { "bbox": [14.1, 49.0, 24.2, 54.9], "on_invalid": "reject" },
    "enums": true,
    "on_error": "reject"
  },
  "drift": {
    "baseline": { "record_count": 1, "generated_at": "2026-11-21" },
    "schema": { "on_new_field": "review", "on_missing_field": "warn", "on_type_change": "fail", "on_header_order_change": "ignore" },
    "volume": { "min_records": 5, "max_delta_ratio": 0.5, "on_breach": "fail" },
    "quality": {
      "max_coord_invalid_ratio": 0.0,
      "max_duplicate_id_ratio": 0.0,
      "max_null_ratio": { "name": 0.0, "lat": 0.0, "lon": 0.0 },
      "on_breach": "review"
    },
    "axis": { "enabled": false },
    "golden_sample": { "size": 1, "required_match_ratio": 1.0 },
    "actions": { "warn": "log", "review": "quarantine", "fail": "disable" }
  },
  "publish": {
    "enabled": false,
    "license_id": "NOASSERTION",
    "attribution": "Mapa Google My Maps Miasta Bydgoszcz; brak licencji",
    "redact": ["serial_number"],
    "exports": []
  }
}
