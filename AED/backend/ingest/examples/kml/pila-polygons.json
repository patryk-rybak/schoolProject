{
  "version": 1,
  "source": {
    "id": "kml-pila",
    "name": "Pilska Sieć AED - punkty i wielokąty zasięgu (KML)",
    "publisher": "Miasto Piła",
    "homepage_url": "https://www.pila.pl/346-pilskie-defibrylatory.html",
    "access_type": "kml",
    "reliability_tier": "official_local",
    "license": {
      "id": "NOASSERTION",
      "url": "https://www.google.com/intl/pl/maps/terms.html",
      "attribution": "Mapa Google My Maps Miasta Piła; brak deklaracji licencji",
      "share_alike": false
    },
    "coverage": {
      "country": "PL",
      "teryt": ["301901"],
      "notes": "Probe 2026-11-21: 97 placemarków, w tym 25 Point, 9 Polygon i 63 bez geometrii. Wcześniejszy audyt opisywał dokument jako 97 polygonów; snapshot jest mieszany. Polygony to zasięgi osiedli, nie AED."
    },
    "update_frequency": "unknown",
    "enabled": false,
    "notes": "Config odrzuca 9 polygonów i 63 placemarki bez geometrii, zostawiając 25 punktów. Punkty są kandydatami do weryfikacji względem listy 15 adresów na stronie miasta. Brak licencji i daty; enabled=false do decyzji licencyjnej. min_point_ratio wykryje dokument zdominowany przez polygony."
  },
  "connector": {
    "family": "google_my_maps_kml",
    "parser": "kml",
    "notes": "Mieszany KML: point_only=true odrzuca Polygon, require_coordinates odrzuca placemarki bez geometrii."
  },
  "fetch": {
    "url": "https://www.google.com/maps/d/kml?mid=15xg0I18PBJ0QZ48TCXPfNzfLkVOCfNSo&forcekml=1",
    "method": "GET",
    "timeout_ms": 30000,
    "retries": { "max": 2, "backoff_ms": 2000 },
    "rate_limit": { "requests_per_minute": 6 },
    "conditional": { "etag": false, "last_modified": false },
    "pagination": { "type": "none" },
    "user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
  },
  "parse": {
    "encoding": "utf-8",
    "kml": {
      "point_only": true,
      "document_name_must_match": "Pilska Sieć AED",
      "require_coordinates": true,
      "on_missing_geometry": "reject",
      "on_non_point_geometry": "reject",
      "min_point_ratio": 1.0,
      "on_low_point_ratio": "review",
      "extended_data_as_object": true,
      "strip_cdata": true,
      "description_format": "text"
    }
  },
  "records": {
    "path": "//Placemark",
    "identity": {
      "source_record_id": {
        "template": "{source_id}:kml:{digest}",
        "vars": {
          "source_id": { "builtin": "source_id" },
          "digest": {
            "func": "stable_hash",
            "args": [
              { "field": "name" },
              { "const": "|" },
              { "coord": { "from": "coordinates", "format": "kml", "pick": "lon" } },
              { "const": "|" },
              { "coord": { "from": "coordinates", "format": "kml", "pick": "lat" } }
            ]
          }
        }
      },
      "dataset_id": { "const": "google-my-maps:15xg0I18PBJ0QZ48TCXPfNzfLkVOCfNSo" },
      "stable": false
    },
    "dedupe": {
      "key": [{ "field": "name" }, { "field": "coordinates" }],
      "keep": "first",
      "on_duplicate": "warn"
    }
  },
  "map": {
    "name": { "field": "name" },
    "description": { "field": "description" },
    "facility_type": { "const": "unknown" },
    "device_type": { "const": "public_aed" },
    "lat": { "coord": { "from": "coordinates", "format": "kml", "pick": "lat", "precision_m": 15, "on_invalid": "reject" } },
    "lon": { "coord": { "from": "coordinates", "format": "kml", "pick": "lon", "precision_m": 15, "on_invalid": "reject" } },
    "coord_precision_m": { "const": 15 },
    "country_code": { "const": "PL" },
    "city": { "const": "Piła" },
    "access_type": { "const": "unknown" },
    "status": { "const": "unknown" },
    "verification_status": { "const": "candidate" },
    "confidence": { "const": 0.45 },
    "source_url": { "const": "https://www.pila.pl/346-pilskie-defibrylatory.html" }
  },
  "validate": {
    "required": ["name", "lat", "lon"],
    "coords": { "bbox": [14.1, 49.0, 24.2, 54.9], "on_invalid": "review" },
    "enums": true,
    "on_error": "reject"
  },
  "drift": {
    "baseline": { "record_count": 25, "generated_at": "2026-11-21" },
    "schema": { "on_new_field": "review", "on_missing_field": "warn", "on_type_change": "fail", "on_header_order_change": "ignore" },
    "volume": { "min_records": 20, "max_delta_ratio": 0.3, "on_breach": "review" },
    "quality": {
      "max_coord_invalid_ratio": 0.0,
      "max_duplicate_id_ratio": 0.0,
      "max_null_ratio": { "name": 0.0, "lat": 0.0, "lon": 0.0 },
      "on_breach": "review"
    },
    "axis": { "enabled": false },
    "golden_sample": { "size": 10, "required_match_ratio": 0.95 },
    "actions": { "warn": "log", "review": "quarantine", "fail": "disable" }
  },
  "publish": {
    "enabled": false,
    "license_id": "NOASSERTION",
    "attribution": "Mapa Google My Maps Miasta Piła; brak licencji",
    "redact": ["serial_number"],
    "exports": []
  }
}
