{
  "version": 1,
  "source": {
    "id": "manowo",
    "name": "Ogólnodostępne defibrylatory AED na terenie Gminy Manowo",
    "publisher": "Gmina Manowo",
    "homepage_url": "https://manowo.pl/strona/defibrylator-aed-na-terenie-gminy-manowo",
    "access_type": "html",
    "reliability_tier": "official_local",
    "license": {
      "id": "NOASSERTION",
      "attribution": "Gmina Manowo — https://manowo.pl/strona/defibrylator-aed-na-terenie-gminy-manowo (brak deklaracji licencji)"
    },
    "coverage": {
      "country": "PL",
      "notes": "Gmina wiejska Manowo, zachodniopomorskie. 8 punktów GM#1-GM#8, wszystkie ze współrzędnymi w formacie (lat, lon)."
    },
    "update_frequency": "unknown",
    "enabled": true,
    "notes": "Klasa B+ z audytu JST. Treść to lista <li>, nie tabela. Każdy element zawiera ID, miejscowość/adres, nazwę obiektu, opis wejścia i parę współrzędnych. Strona nie podaje daty aktualizacji. Stopka: wszystkie prawa zastrzeżone, więc publikacja wyłączona."
  },
  "connector": {
    "family": "html_list",
    "parser": "html_list",
    "notes": "Selektor li + filtr tekstu Defibrylator AED GM#. Pola wyciągane regexami z tekstu elementu."
  },
  "fetch": {
    "url": "https://manowo.pl/strona/defibrylator-aed-na-terenie-gminy-manowo",
    "method": "GET",
    "timeout_ms": 30000,
    "retries": { "max": 2, "backoff_ms": 1500 },
    "rate_limit": { "requests_per_minute": 6 },
    "conditional": { "etag": true, "last_modified": true },
    "pagination": { "type": "none" },
    "user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
  },
  "parse": {
    "encoding": "utf-8",
    "trim_headers": false,
    "html_list": {
      "select": "li",
      "record_filter": { "regex": "Defibrylator AED GM#\\d+" },
      "fields": {
        "device_id": { "regex": "GM#(\\d+)", "group": 1 },
        "place": { "regex": "Defibrylator AED GM#\\d+\\s*-\\s*(.*?)\\s*[–-]\\s*", "group": 1 },
        "facility": { "regex": "[–-]\\s*(.*?)\\s*\\(", "group": 1 },
        "entrance": { "regex": "\\(([^()]*)\\)\\s*\\(", "group": 1 },
        "coords": { "regex": "\\(([\\d.]+),\\s*([\\d.]+)\\)\\s*$", "group": 0 },
        "lat": { "regex": "\\(([\\d.]+),\\s*[\\d.]+\\),?\\s*$", "group": 1 },
        "lon": { "regex": "\\([\\d.]+,\\s*([\\d.]+)\\)\\s*$", "group": 1 },
        "city": { "regex": "^([^\\s]+)", "group": 1 }
      },
      "item_text_separator": " ",
      "trim": true,
      "collapse_whitespace": true,
      "empty_as_null": true,
      "min_records": 8,
      "max_records": 12
    }
  },
  "records": {
    "path": "$",
    "identity": {
      "source_record_id": { "template": "manowo:GM#{device_id}" },
      "dataset_id": { "const": "manowo:html:aed" },
      "stable": true
    },
    "dedupe": { "key": [{ "field": "device_id" }], "keep": "last", "on_duplicate": "reject" }
  },
  "map": {
    "source_url": { "const": "https://manowo.pl/strona/defibrylator-aed-na-terenie-gminy-manowo" },
    "name": { "field": "place" },
    "label": { "template": "GM#{device_id}" },
    "description": { "field": "facility" },
    "note": { "field": "text" },
    "facility_type": { "const": "unknown" },
    "lat": { "func": "to_float", "args": [{ "field": "lat" }] },
    "lon": { "func": "to_float", "args": [{ "field": "lon" }] },
    "coord_precision_m": { "const": 15 },
    "country_code": { "const": "PL" },
    "city": { "field": "city" },
    "address_text": { "field": "place" },
    "entrance_description": { "field": "entrance" },
    "access_type": { "const": "public" },
    "is_24_7": { "const": true },
    "device_type": { "const": "public_aed" },
    "status": { "const": "unknown" },
    "verification_status": { "const": "unverified" },
    "confidence": { "const": 0.7 },
    "last_verified_at": { "const": null },
    "operator_name": { "const": "Gmina Manowo" },
    "operator_type": { "const": "municipality" },
    "source_updated_at": { "const": null }
  },
  "validate": {
    "required": ["name", "lat", "lon"],
    "coords": { "bbox": [16.2, 54.0, 16.5, 54.2], "on_invalid": "review" },
    "enums": true,
    "on_error": "review"
  },
  "drift": {
    "baseline": {
      "record_count": 8,
      "generated_at": "2026-11-21",
      "schema_fields": ["text", "device_id", "place", "facility", "entrance", "coords", "lat", "lon", "city"]
    },
    "schema": { "on_new_field": "review", "on_missing_field": "fail", "on_type_change": "review", "on_header_order_change": "ignore" },
    "volume": { "min_records": 6, "max_delta_ratio": 0.5, "on_breach": "review" },
    "quality": {
      "max_coord_invalid_ratio": 0.0,
      "max_duplicate_id_ratio": 0.0,
      "max_null_ratio": { "name": 0.0, "lat": 0.0, "lon": 0.0 },
      "on_breach": "review"
    },
    "axis": { "enabled": true, "max_suspicious_ratio": 0.0, "on_breach": "review" },
    "golden_sample": { "size": 8, "required_match_ratio": 1.0 },
    "actions": { "warn": "log", "review": "quarantine", "fail": "disable" }
  },
  "publish": {
    "enabled": false,
    "license_id": "NOASSERTION",
    "attribution": "Gmina Manowo — wszystkie prawa zastrzeżone; publikacja wymaga zgody wydawcy",
    "redact": [],
    "exports": []
  }
}
