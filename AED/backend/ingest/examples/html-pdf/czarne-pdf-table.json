{
  "version": 1,
  "source": {
    "id": "czarne",
    "name": "Lokalizacje defibrylatorów AED w gminie Czarne",
    "publisher": "Gmina Czarne",
    "homepage_url": "https://czarne.pl/files/file_add/download/35_document.pdf",
    "access_type": "file",
    "reliability_tier": "official_local",
    "license": {
      "id": "NOASSERTION",
      "attribution": "Gmina Czarne — https://czarne.pl/files/file_add/download/35_document.pdf (brak deklaracji licencji)"
    },
    "coverage": {
      "country": "PL",
      "notes": "Gmina miejsko-wiejska Czarne, pomorskie. 20 punktów w jednej tabeli PDF, wszystkie ze współrzędnymi WGS84."
    },
    "update_frequency": "unknown",
    "enabled": false,
    "notes": "Klasa B+ z audytu JST. PDF 1.7, 1 strona, warstwa tekstowa (Word 2016). Metadane PDF: CreationDate/ModDate 2026-02-19. Nagłówek tabeli: lp., Nazwa obiektu, Adres, Współrzędne geograficzne, Umieszczenie AED, Uwagi. Kolumny są wielowierszowe i nie są wyrównane do jednej linii bazowej, dlatego wymagana jest rekonstrukcja po pozycjach słów i kotwicy lp. Do czasu wdrożenia parsera pdf_table config pozostaje wyłączony."
  },
  "connector": {
    "family": "pdf_table",
    "parser": "pdf_table",
    "notes": "Warstwa tekstowa PDF, rekonstrukcja tabeli po współrzędnych x/y. Bez OCR. Kotwica wiersza: komórka lp pasująca do ^\\d+\\.$."
  },
  "fetch": {
    "url": "https://czarne.pl/files/file_add/download/35_document.pdf",
    "method": "GET",
    "timeout_ms": 45000,
    "retries": { "max": 2, "backoff_ms": 2000 },
    "rate_limit": { "requests_per_minute": 4 },
    "conditional": { "etag": true, "last_modified": true },
    "pagination": { "type": "none" },
    "user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
  },
  "parse": {
    "encoding": "binary",
    "trim_headers": false,
    "pdf_table": {
      "pages": [1],
      "require_text_layer": true,
      "min_text_chars": 500,
      "expected_page_count": 1,
      "strategy": "word_positions",
      "columns": [
        { "key": "lp", "x_min": 0, "x_max": 55 },
        { "key": "name", "x_min": 55, "x_max": 205 },
        { "key": "address", "x_min": 205, "x_max": 315 },
        { "key": "coords", "x_min": 315, "x_max": 425 },
        { "key": "placement", "x_min": 425, "x_max": 500 },
        { "key": "availability", "x_min": 500, "x_max": 596 }
      ],
      "row_anchor": { "column": "lp", "regex": "^\\d+\\.$" },
      "row_tolerance": 2.5,
      "multi_line": "join_space",
      "trim": true,
      "collapse_whitespace": true,
      "empty_as_null": true,
      "min_records": 20,
      "max_records": 20
    }
  },
  "records": {
    "path": "$",
    "identity": {
      "source_record_id": { "template": "czarne:{lp}" },
      "dataset_id": { "const": "czarne:pdf:aed" },
      "stable": true
    },
    "dedupe": { "key": [{ "field": "lp" }], "keep": "last", "on_duplicate": "reject" }
  },
  "map": {
    "source_url": { "const": "https://czarne.pl/files/file_add/download/35_document.pdf" },
    "name": { "field": "name" },
    "label": { "template": "czarne:{lp}" },
    "description": { "field": "placement" },
    "note": {
      "template": "{placement}; {availability}",
      "vars": {
        "placement": { "field": "placement" },
        "availability": { "field": "availability" }
      }
    },
    "facility_type": {
      "when": { "op": "regex", "left": { "field": "name" }, "right": "(?i)Ochotnicza Straż Pożarna" },
      "then": "osp_fire_station",
      "else": {
        "when": { "op": "regex", "left": { "field": "name" }, "right": "(?i)Urząd Miasta" },
        "then": "municipal_office",
        "else": {
          "when": { "op": "regex", "left": { "field": "name" }, "right": "(?i)Szkoła" },
          "then": "school",
          "else": {
            "when": { "op": "regex", "left": { "field": "name" }, "right": "(?i)Boisko" },
            "then": "sports_venue",
            "else": "unknown"
          }
        }
      }
    },
    "lat": {
      "coord": {
        "from": { "field": "coords" },
        "format": "pair",
        "order": "lat_lon",
        "delimiter": ",",
        "pick": "lat",
        "precision_m": 15,
        "axis_policy": "declared",
        "on_invalid": "review"
      }
    },
    "lon": {
      "coord": {
        "from": { "field": "coords" },
        "format": "pair",
        "order": "lat_lon",
        "delimiter": ",",
        "pick": "lon",
        "precision_m": 15,
        "axis_policy": "declared",
        "on_invalid": "review"
      }
    },
    "coord_precision_m": { "const": 15 },
    "country_code": { "const": "PL" },
    "city": { "regex": { "in": { "field": "address" }, "pattern": "^([^\\s,]+)" } },
    "address_text": { "field": "address" },
    "indoor": {
      "when": { "op": "regex", "left": { "field": "placement" }, "right": "(?i)^Wewnątrz" },
      "then": true,
      "else": {
        "when": { "op": "regex", "left": { "field": "placement" }, "right": "(?i)^Na zewnątrz" },
        "then": false,
        "else": null
      }
    },
    "entrance_description": { "field": "placement" },
    "access_type": {
      "when": { "op": "regex", "left": { "field": "availability" }, "right": "24h" },
      "then": "public",
      "else": "private"
    },
    "opening_hours": {
      "when": { "op": "regex", "left": { "field": "availability" }, "right": "24h" },
      "then": null,
      "else": { "field": "availability" }
    },
    "is_24_7": {
      "when": { "op": "regex", "left": { "field": "availability" }, "right": "24h" },
      "then": true,
      "else": false
    },
    "device_type": { "const": "public_aed" },
    "status": { "const": "unknown" },
    "verification_status": { "const": "unverified" },
    "confidence": { "const": 0.85 },
    "last_verified_at": { "const": null },
    "operator_name": { "const": "Gmina Czarne" },
    "operator_type": { "const": "municipality" },
    "source_updated_at": { "const": "2026-02-19" }
  },
  "validate": {
    "required": ["name", "lat", "lon"],
    "coords": { "bbox": [16.88, 53.58, 17.18, 53.72], "on_invalid": "review" },
    "enums": true,
    "on_error": "review"
  },
  "drift": {
    "baseline": {
      "record_count": 20,
      "generated_at": "2026-11-21",
      "schema_fields": ["lp", "name", "address", "coords", "placement", "availability"]
    },
    "schema": { "on_new_field": "review", "on_missing_field": "fail", "on_type_change": "review", "on_header_order_change": "review" },
    "volume": { "min_records": 18, "max_delta_ratio": 0.25, "on_breach": "review" },
    "quality": {
      "max_coord_invalid_ratio": 0.0,
      "max_duplicate_id_ratio": 0.0,
      "max_null_ratio": { "name": 0.0, "lat": 0.0, "lon": 0.0 },
      "on_breach": "review"
    },
    "axis": { "enabled": true, "max_suspicious_ratio": 0.0, "on_breach": "review" },
    "golden_sample": { "size": 20, "required_match_ratio": 1.0 },
    "actions": { "warn": "log", "review": "quarantine", "fail": "disable" }
  },
  "publish": {
    "enabled": false,
    "license_id": "NOASSERTION",
    "attribution": "Gmina Czarne — brak deklaracji licencji; publikacja wymaga zgody wydawcy",
    "redact": [],
    "exports": []
  }
}
