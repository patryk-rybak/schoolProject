		"id": "zielona-gora",
		"license": {
			"attribution": "Mapa Google My Maps Miasta Zielona Góra; brak deklaracji licencji",
			"id": "NOASSERTION",
			"share_alike": false,
			"url": "https://www.google.com/intl/pl/maps/terms.html"
		},
		"name": "AED w Zielonej Górze (Google My Maps, KML)",
		"notes": "Eksport nieudokumentowanego endpointu Google My Maps. Brak licencji i daty; źródło jest użyteczne do seedowania i weryfikacji, ale wymaga zgody wydawcy przed ingestią i eksportem. Włącznik enabled=false do czasu decyzji licencyjnej (G2).",
		"publisher": "Miasto Zielona Góra",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				14.1,
				49,
				24.2,
				54.9
			],
			"on_invalid": "reject"
		},
		"enums": true,
