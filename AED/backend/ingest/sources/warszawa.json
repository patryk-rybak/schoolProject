{
	"connector": {
		"family": "http_json",
		"notes": "POST JSON; odpowiedź to tablica obiektów GeoJSON-like.",
		"parser": "json"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": null
		},
		"golden_sample": {
			"required_match_ratio": 0.95,
			"size": 10
		},
		"quality": {
			"max_coord_invalid_ratio": 0.02,
			"max_duplicate_id_ratio": 0,
			"max_null_ratio": {
				"lat": 0,
				"lon": 0,
				"name": 0.1
			},
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "review",
			"on_new_field": "warn",
			"on_type_change": "fail"
		},
		"volume": {
			"max_delta_ratio": 1,
			"min_records": 1,
			"on_breach": "review"
		}
	},
	"fetch": {
		"auth": {
			"env": "WARSZAWA_API_TOKEN",
			"header": "Authorization",
			"type": "header"
		},
		"body": {},
		"conditional": {
			"etag": false,
			"last_modified": false
		},
		"headers": {
			"Content-Type": "application/json"
		},
		"method": "POST",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 30
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 3
		},
		"timeout_ms": 30000,
		"url": "https://dane.um.warszawa.pl/api/action/get_scb_lokalizacja_defibrylatorow",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"map": {
		"access_type": {
			"map": {
				"cases": {
					"false": "private",
					"nie": "private",
					"niepubliczny": "private",
					"no": "private",
					"ogolnodostepny": "public",
					"ogólnodostępny": "public",
					"prywatny": "private",
					"public": "public",
					"publiczny": "public",
					"tak": "public",
					"true": "public",
					"yes": "public"
				},
				"default": "unknown",
				"value": {
					"args": [
						{
							"field": "properties.device_public_access"
						}
					],
					"func": "lower"
				}
			}
		},
		"address_text": {
			"template": "{street}, {postcode} {city}",
			"vars": {
				"city": {
					"field": "properties.location_city"
				},
				"postcode": {
					"field": "properties.location_postcode"
				},
				"street": {
					"field": "properties.location_street"
				}
			}
		},
		"city": {
			"field": "properties.location_city"
		},
		"confidence": {
			"const": 0.8
		},
		"coord_precision_m": {
			"const": 15
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"entrance_description": {
			"field": "properties.location_description"
		},
		"facility_type": {
			"const": "unknown"
		},
		"is_24_7": {
			"else": null,
			"then": true,
			"when": {
				"left": {
					"args": [
						{
							"field": "properties.device_access_description"
						}
					],
					"func": "lower"
				},
				"op": "regex",
				"right": "(24|całodob|calodob)"
			}
		},
		"label": {
			"field": "properties.defibrillator_id"
		},
		"lat": {
			"coord": {
				"format": "geojson",
				"from": "geometry",
				"on_invalid": "reject",
				"pick": "lat",
				"unwrap_single": true
			}
		},
		"lon": {
			"coord": {
				"format": "geojson",
				"from": "geometry",
				"on_invalid": "reject",
				"pick": "lon",
				"unwrap_single": true
			}
		},
		"manufacturer": {
			"field": "properties.device_manufacturer"
		},
		"name": {
			"coalesce": [
				{
					"field": "properties.location_object_name"
				},
				{
					"field": "properties.location_building"
				},
				{
					"field": "properties.location_description"
				}
			]
		},
		"note": {
			"field": "properties.device_access_description"
		},
		"operator_name": {
			"const": null
		},
		"operator_type": {
			"const": null
		},
		"postcode": {
			"field": "properties.location_postcode"
		},
		"source_updated_at": {
			"const": "2026-06-01"
		},
		"status": {
			"const": "unknown"
		},
		"street": {
			"field": "properties.location_street"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"json": {
			"unwrap_string": false
		}
	},
	"publish": {
		"allowed_for_export": true,
		"allowed_for_ingest": true,
		"attribution": "m.st. Warszawa — dane.gov.pl, CC BY 4.0",
		"enabled": false,
		"exports": [
			"csv",
			"geojson"
		],
		"license_id": "CC-BY-4.0",
		"redact": [
			"serial_number",
			"phone"
		],
		"terms_checked_at": "2026-11-21T00:00:00Z",
		"terms_hash": "sha256:2c31f90b734f0e2dd5dc017737eb2094e133be99a188396659c9cdb3bd3d0625",
		"terms_url": "https://creativecommons.org/licenses/by/4.0/"
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "properties.defibrillator_id"
				}
			],
			"on_duplicate": "reject"
		},
		"identity": {
			"dataset_id": {
				"const": "dane.gov.pl:39512"
			},
			"source_record_id": {
				"template": "warszawa:{properties.defibrillator_id}"
			},
			"stable": true
		},
		"path": "$"
	},
	"source": {
		"access_type": "api",
		"coverage": {
			"country": "PL",
			"notes": "Najbardziej kompletny schemat miejski; brak statusu i daty weryfikacji.",
			"teryt": [
				"146501"
			]
		},
		"enabled": false,
		"homepage_url": "https://dane.gov.pl/pl/dataset/39512",
		"id": "warszawa",
		"license": {
			"attribution": "m.st. Warszawa — dane.gov.pl, CC BY 4.0",
			"id": "CC-BY-4.0",
			"share_alike": false,
			"url": "https://creativecommons.org/licenses/by/4.0/"
		},
		"name": "Lokalizacja defibrylatorów (AED) — m.st. Warszawa",
		"notes": "API wymaga tokena. device_availability jest opisowe (np. \"Ograniczona\"), więc nie mapujemy go wprost na boolean. attachment to Base64, nie URL. Włącznik enabled=false do czasu potwierdzenia trybu listowania.\n",
		"publisher": "m.st. Warszawa",
		"reliability_tier": "official_local",
		"update_frequency": "daily"
	},
	"validate": {
		"coords": {
			"bbox": [
				14.1,
				49,
				24.2,
				54.9
			],
			"on_invalid": "reject"
		},
		"enums": true,
		"on_error": "reject",
		"required": [
			"name",
			"lat",
			"lon"
		]
	},
	"version": 1
}
