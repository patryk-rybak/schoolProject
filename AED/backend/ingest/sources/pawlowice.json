{
	"connector": {
		"family": "google_my_maps_kml",
		"notes": "Punktowy KML; prefiks nazwy usuwany, description mapowany na address_text.",
		"parser": "kml"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 12
		},
		"golden_sample": {
			"required_match_ratio": 0.95,
			"size": 10
		},
		"quality": {
			"max_coord_invalid_ratio": 0,
			"max_duplicate_id_ratio": 0,
			"max_null_ratio": {
				"lat": 0,
				"lon": 0,
				"name": 0
			},
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "warn",
			"on_new_field": "review",
			"on_type_change": "fail"
		},
		"volume": {
			"max_delta_ratio": 0.2,
			"min_records": 10,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": false,
			"last_modified": false
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 2000,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://www.google.com/maps/d/kml?mid=1DSs_ESjkEU6AaxZjgpLgwtk5tlG11gc&forcekml=1",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"field": "description"
		},
		"confidence": {
			"const": 0.55
		},
		"coord_precision_m": {
			"const": 15
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"facility_type": {
			"const": "unknown"
		},
		"lat": {
			"coord": {
				"format": "kml",
				"from": "coordinates",
				"on_invalid": "reject",
				"pick": "lat",
				"precision_m": 15
			}
		},
		"lon": {
			"coord": {
				"format": "kml",
				"from": "coordinates",
				"on_invalid": "reject",
				"pick": "lon",
				"precision_m": 15
			}
		},
		"name": {
			"args": [
				{
					"args": [
						{
							"field": "name"
						},
						{
							"const": "Defibrylator AED - "
						}
					],
					"func": "strip_prefix"
				}
			],
			"func": "trim"
		},
		"source_url": {
			"const": "https://www.pawlowice.pl/mieszkaniec/zdrowie/mapa-defibrylatorow-aed"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"kml": {
			"document_name_must_match": "Defibrylatory AED - Gmina Pawłowice",
			"point_only": true
		}
	},
	"publish": {
		"attribution": "Mapa Google My Maps Gminy Pawłowice; brak licencji",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION",
		"redact": [
			"serial_number"
		]
	},
	"records": {
		"dedupe": {
			"keep": "first",
			"key": [
				{
					"field": "name"
				},
				{
					"field": "coordinates"
				}
			],
			"on_duplicate": "warn"
		},
		"identity": {
			"dataset_id": {
				"const": "google-my-maps:1DSs_ESjkEU6AaxZjgpLgwtk5tlG11gc"
			},
			"source_record_id": {
				"template": "{source_id}:kml:{digest}",
				"vars": {
					"digest": {
						"args": [
							{
								"field": "name"
							},
							{
								"const": "|"
							},
							{
								"coord": {
									"format": "kml",
									"from": "coordinates",
									"pick": "lon"
								}
							},
							{
								"const": "|"
							},
							{
								"coord": {
									"format": "kml",
									"from": "coordinates",
									"pick": "lat"
								}
							}
						],
						"func": "stable_hash"
					},
					"source_id": {
						"builtin": "source_id"
					}
				}
			},
			"stable": false
		},
		"path": "//Placemark"
	},
	"source": {
		"access_type": "kml",
		"coverage": {
			"country": "PL",
			"notes": "12 punktów w probie 2026-11-21 (licznik stabilny w dwóch pobraniach); w tym 7 OSP. TERYT gminy do potwierdzenia w rejestrze przed aktywacją.",
			"teryt": [
				"241004"
			]
		},
		"enabled": false,
		"homepage_url": "https://www.pawlowice.pl/mieszkaniec/zdrowie/mapa-defibrylatorow-aed",
		"id": "pawlowice",
		"license": {
			"attribution": "Mapa Google My Maps Gminy Pawłowice; brak deklaracji licencji",
			"id": "NOASSERTION",
			"share_alike": false,
			"url": "https://www.google.com/intl/pl/maps/terms.html"
		},
		"name": "Defibrylatory AED - Gmina Pawłowice (KML)",
		"notes": "Brak licencji i daty. Nazwa ma prefiks 'Defibrylator AED - ', a description zawiera adres. Włącznik enabled=false do decyzji licencyjnej.",
		"publisher": "Gmina Pawłowice",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				14.1,
				49,
				24.2,
				54.9
			],
			"on_invalid": "reject"
		},
		"enums": true,
		"on_error": "reject",
		"require_location": "point",
		"required": [
			"lat",
			"lon"
		]
	},
	"version": 1
}
