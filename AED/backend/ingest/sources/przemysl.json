{
	"connector": {
		"family": "http_json",
		"notes": "Paginacja page/per_page; total_rows w odpowiedzi. Limit 120 req/min.",
		"parser": "json"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 21,
			"schema_fields": [
				"id",
				"name",
				"description",
				"category",
				"city",
				"street",
				"home_number",
				"postcode",
				"phone",
				"email",
				"www",
				"gallery",
				"attachments",
				"links",
				"geometry",
				"longitude",
				"latitude",
				"youtube_url",
				"panorama_url"
			]
		},
		"golden_sample": {
			"required_match_ratio": 1,
			"size": 10
		},
		"quality": {
			"max_coord_invalid_ratio": 0,
			"max_duplicate_id_ratio": 0,
			"max_null_ratio": {
				"email": 0.9,
				"name": 0,
				"phone": 0.9,
				"website": 0.9
			},
			"on_breach": "warn"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "review",
			"on_new_field": "warn",
			"on_type_change": "fail"
		},
		"volume": {
			"max_delta_ratio": 0.5,
			"min_records": 15,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"limit_param": "per_page",
			"page_param": "page",
			"page_size": 100,
			"start_page": 1,
			"total_path": "/total_rows",
			"type": "page"
		},
		"rate_limit": {
			"requests_per_minute": 60
		},
		"retries": {
			"backoff_ms": 1000,
			"max": 3
		},
		"timeout_ms": 30000,
		"url": "https://dane.przemysl.eu/wp-json/sod/v1/resources/15/structured",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"city": {
			"field": "city"
		},
		"confidence": {
			"const": 0.85
		},
		"coord_precision_m": {
			"const": 15
		},
		"country_code": {
			"const": "PL"
		},
		"device_type": {
			"const": "public_aed"
		},
		"email": {
			"args": [
				{
					"field": "email"
				}
			],
			"func": "normalize_email"
		},
		"facility_type": {
			"const": "unknown"
		},
		"house_number": {
			"on_missing": "null",
			"value": {
				"field": "home_number"
			}
		},
		"label": {
			"args": [
				{
					"field": "name"
				}
			],
			"func": "derive_device_identifier"
		},
		"last_verified_at": {
			"const": "2024-11-05"
		},
		"lat": {
			"args": [
				{
					"field": "latitude"
				}
			],
			"func": "to_float"
		},
		"lon": {
			"args": [
				{
					"field": "longitude"
				}
			],
			"func": "to_float"
		},
		"name": {
			"args": [
				{
					"field": "name"
				}
			],
			"func": "derive_location_name"
		},
		"operator_name": {
			"const": null
		},
		"operator_type": {
			"const": null
		},
		"phone": {
			"args": [
				{
					"field": "phone"
				}
			],
			"func": "normalize_phone"
		},
		"photo_url": {
			"field": "gallery[0].url"
		},
		"postcode": {
			"field": "postcode"
		},
		"source_updated_at": {
			"const": "2024-11-05"
		},
		"status": {
			"const": "unknown"
		},
		"street": {
			"field": "street"
		},
		"verification_status": {
			"const": "unverified"
		},
		"website": {
			"args": [
				{
					"field": "www"
				}
			],
			"func": "normalize_url"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"json": {
			"unwrap_string": false
		}
	},
	"publish": {
		"allowed_for_export": true,
		"allowed_for_ingest": true,
		"attribution": "Miasto Przemyśl — Portal Otwartych Danych, CC BY 4.0",
		"enabled": true,
		"exports": [
			"geojson",
			"csv"
		],
		"license_id": "CC-BY-4.0",
		"redact": [],
		"terms_checked_at": "2026-11-21T00:00:00Z",
		"terms_hash": "sha256:2c31f90b734f0e2dd5dc017737eb2094e133be99a188396659c9cdb3bd3d0625",
		"terms_url": "https://creativecommons.org/licenses/by/4.0/"
	},
	"records": {
		"dedupe": {
			"keep": "last",
			"key": [
				{
					"field": "id"
				}
			],
			"on_duplicate": "reject"
		},
		"identity": {
			"dataset_id": {
				"const": "przemysl:13:15"
			},
			"source_record_id": {
				"template": "przemysl:15:{id}"
			},
			"stable": true
		},
		"path": "/rows"
	},
	"source": {
		"access_type": "api",
		"coverage": {
			"country": "PL",
			"notes": "21 rekordów, geometria Point EPSG:4326. Mirror dane.gov.pl: CC0 1.0.",
			"teryt": [
				"186201"
			]
		},
		"enabled": true,
		"homepage_url": "https://dane.przemysl.eu/",
		"id": "przemysl",
		"license": {
			"attribution": "Miasto Przemyśl — Portal Otwartych Danych, CC BY 4.0",
			"id": "CC-BY-4.0",
			"share_alike": false,
			"url": "https://creativecommons.org/licenses/by/4.0/"
		},
		"name": "Otwarte Dane Przemyśl — defibrylatory AED",
		"notes": "Deklarowana aktualizacja codzienna, ale plik źródłowy pochodzi z 2024-11-05. Duplikat numeru AED 7639 w rekordach 757 i 764. Brak operatora, statusu, godzin i informacji o wejściu.\n",
		"publisher": "Gmina Miasto Przemyśl",
		"reliability_tier": "official_local",
		"update_frequency": "daily"
	},
	"validate": {
