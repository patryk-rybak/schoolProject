{
	"connector": {
		"family": "html_list",
		"notes": "Lista `<ol>` w `div.postbox__text` ma 15 pozycji, każda zaczyna się od „Defibrylator …”. Linki do e-mapy są w treści, ale strona publikuje adresy; współrzędne tylko przez e-mapę, więc adresy geokodujemy przez UUG.",
		"parser": "html_list"
	},
	"drift": {
		"actions": {
			"fail": "disable",
			"review": "quarantine",
			"warn": "log"
		},
		"axis": {
			"enabled": false,
			"max_suspicious_ratio": 0.1,
			"on_breach": "review"
		},
		"baseline": {
			"generated_at": "2026-11-21",
			"record_count": 15
		},
		"quality": {
			"max_coord_invalid_ratio": 1,
			"max_duplicate_id_ratio": 0.1,
			"on_breach": "review"
		},
		"schema": {
			"on_header_order_change": "ignore",
			"on_missing_field": "review",
			"on_new_field": "review",
			"on_type_change": "review"
		},
		"volume": {
			"max_delta_ratio": 0.5,
			"min_records": 15,
			"on_breach": "review"
		}
	},
	"fetch": {
		"conditional": {
			"etag": true,
			"last_modified": true
		},
		"method": "GET",
		"pagination": {
			"type": "none"
		},
		"rate_limit": {
			"requests_per_minute": 6
		},
		"retries": {
			"backoff_ms": 1500,
			"max": 2
		},
		"timeout_ms": 30000,
		"url": "https://pruszcz-gdanski.pl/defibrylatory",
		"user_agent": "AED-PL-ingest/0.1 (+https://example.org/aed; contact: data@example.org)"
	},
	"geocoding": {
		"address_template": "{address_text}, {city}",
		"cache_ttl_days": 365,
		"enabled": true,
		"geoportal": {
			"endpoint": "https://services.gugik.gov.pl/uug/",
			"max_results": 5,
			"min_accuracy": 0.8,
			"only_exact_numbers": true,
			"output_srid": 4326,
			"request": "GetAddress",
			"srid": 2180
		},
		"min_confidence": 0.8,
		"on_failure": "address_only",
		"provider_order": [
			"gugik-uug"
		],
		"rate_limit": {
			"requests_per_minute": 30
		},
		"required_components": [
			"city"
		],
		"strategy": "structured_first"
	},
	"map": {
		"access_type": {
			"const": "unknown"
		},
		"address_text": {
			"coalesce": [
				{
					"field": "address"
				},
				{
					"field": "text"
				}
			]
		},
		"city": {
			"const": "Pruszcz Gdański"
		},
		"confidence": {
			"const": 0.3
		},
		"country_code": {
			"const": "PL"
		},
		"facility_type": {
			"const": "unknown"
		},
		"name": {
			"template": "Defibrylator {kind} – {address}",
			"vars": {
				"address": {
					"field": "address"
				},
				"kind": {
					"field": "kind"
				}
			}
		},
		"source_url": {
			"const": "https://pruszcz-gdanski.pl/defibrylatory"
		},
		"status": {
			"const": "unknown"
		},
		"verification_status": {
			"const": "unverified"
		}
	},
	"parse": {
		"encoding": "utf-8",
		"html_list": {
			"collapse_whitespace": true,
			"empty_as_null": true,
			"fields": {
				"address": {
					"group": 1,
					"regex": "przy\\s+((?:ul\\.|al\\.)[^,]+(?:,\\s*\\d{2}-\\d{3}\\s+[^,\\.]+)?)"
				},
				"kind": {
					"group": 1,
					"regex": "^Defibrylator\\s+([a-ząćęłńóśźż]+)"
				}
			},
			"max_records": 20,
			"min_records": 15,
			"record_filter": {
				"regex": "^Defibrylator\\s+(zewnętrzny|przenośny)"
			},
			"select": "li",
			"trim": true
		},
		"trim_headers": true
	},
	"publish": {
		"allowed_for_export": false,
		"allowed_for_ingest": false,
		"attribution": "Pruszcz Gdański — NOASSERTION",
		"enabled": false,
		"exports": [],
		"license_id": "NOASSERTION"
	},
	"records": {
		"identity": {
			"source_record_id": {
				"template": "pruszcz-gdanski:{row_index}"
			},
			"stable": false
		},
		"path": "$"
	},
	"schedule": {
		"cron": "0 3 * * 1",
		"jitter_seconds": 300,
		"timezone": "Europe/Warsaw"
	},
	"source": {
		"access_type": "html",
		"coverage": {
			"country": "PL",
			"notes": "pomorskie; miasto; 15 adresów w liście; każda pozycja linkuje do obiektu e-mapa, współrzędne tylko przez e-mapę. 15 adresów; linki do obiektów e-mapa.",
			"teryt": [
				"2204011"
			]
		},
		"enabled": false,
		"homepage_url": "https://pruszcz-gdanski.pl/defibrylatory",
		"id": "pruszcz-gdanski",
		"license": {
			"attribution": "Pruszcz Gdański: brak deklaracji licencji",
			"id": "NOASSERTION"
		},
		"name": "Pruszcz Gdański",
		"notes": "15 adresów w liście; każda pozycja linkuje do obiektu e-mapa, współrzędne tylko przez e-mapę. 15 adresów; linki do obiektów e-mapa.",
		"publisher": "Pruszcz Gdański",
		"reliability_tier": "official_local",
		"update_frequency": "unknown"
	},
	"validate": {
		"coords": {
			"bbox": [
				14.07,
				49,
				24.15,
				54.84
			],
			"on_invalid": "review",
			"on_missing": "review"
		},
		"enums": true,
		"on_error": "review",
		"require_location": "address_or_point",
		"required": [
			"name",
			"address_text"
		]
	},
	"version": 1
}
