{
  "name": "schoolproject",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "intent": {
    "skills": ["@tanstack/*"]
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "postinstall": "bun scripts/copy-maplibre-worker.ts",
    "predev": "bun scripts/copy-maplibre-worker.ts",
    "prebuild": "bun scripts/copy-maplibre-worker.ts",
    "dev": "bunx --bun vite dev --port 3000",
    "build": "bunx --bun vite build",
    "preview": "bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --only=a11y --only=complexity --only=correctness --only=nursery --only=performance --only=security --only=style --only=suspicious --skip=nursery/useExplicitType --skip=nursery/noTernary --skip=nursery/noJsxPropsBind --skip=style/noJsxLiterals --skip=style/useNamingConvention --skip=style/useFilenamingConvention --skip=style/useExportsLast --skip=style/useComponentExportOnlyModules --skip=style/noHeadElement --skip=performance/noImgElement --skip=correctness/useQwikValidLexicalScope --skip=suspicious/noReactSpecificProps --error-on-warnings",
    "check": "biome check --only=a11y --only=complexity --only=correctness --only=nursery --only=performance --only=security --only=style --only=suspicious --skip=nursery/useExplicitType --skip=nursery/noTernary --skip=nursery/noJsxPropsBind --skip=style/noJsxLiterals --skip=style/useNamingConvention --skip=style/useFilenamingConvention --skip=style/useExportsLast --skip=style/useComponentExportOnlyModules --skip=style/noHeadElement --skip=performance/noImgElement --skip=correctness/useQwikValidLexicalScope --skip=suspicious/noReactSpecificProps --error-on-warnings",
    "check:write": "biome check --write --unsafe --only=a11y --only=complexity --only=correctness --only=nursery --only=performance --only=security --only=style --only=suspicious --skip=nursery/useExplicitType --skip=nursery/noTernary --skip=nursery/noJsxPropsBind --skip=style/noJsxLiterals --skip=style/useNamingConvention --skip=style/useFilenamingConvention --skip=style/useExportsLast --skip=style/useComponentExportOnlyModules --skip=style/noHeadElement --skip=performance/noImgElement --skip=correctness/useQwikValidLexicalScope --skip=suspicious/noReactSpecificProps",
    "verify": "bun run typecheck && bun run check",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:pull": "bunx --bun drizzle-kit pull",
    "db:studio": "bunx --bun drizzle-kit studio",
    "map:tiles": "bash scripts/fetch-poland-pmtiles.sh",
    "ingest:configs:build": "bun scripts/build-source-configs.ts",
    "ingest:configs:validate": "bun scripts/validate-source-configs.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.19.0",
    "nitro": "^3.0.261103-rc",
    "pmtiles": "4.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "ajv": "^8.20.0",
    "@libsql/client": "^0.15.15",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.8"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
