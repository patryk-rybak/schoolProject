{
  "name": "schoolproject",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  },
  "imports": {
    "#/*": "./frontend/*",
    "#backend/*": "./backend/*"
  },
  "scripts": {
    "postinstall": "bun frontend/scripts/copy-maplibre-worker.ts",
    "predev": "bun frontend/scripts/copy-maplibre-worker.ts",
    "prebuild": "bun frontend/scripts/copy-maplibre-worker.ts",
    "dev": "bunx --bun vite dev --port 3000",
    "dev:tls": "bun frontend/scripts/dev-tls-proxy.ts",
    "build": "bunx --bun vite build",
    "preview": "bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --only=a11y --only=complexity --only=correctness --only=nursery --only=performance --only=security --only=style --only=suspicious --skip=nursery/useExplicitType --skip=nursery/noTernary --skip=nursery/noJsxPropsBind --skip=style/noJsxLiterals --skip=style/useNamingConvention --skip=style/useFilenamingConvention --skip=style/useExportsLast --skip=style/useComponentExportOnlyModules --skip=style/noHeadElement --skip=performance/noImgElement --skip=correctness/useQwikValidLexicalScope --skip=suspicious/noReactSpecificProps --error-on-warnings --skip=suspicious/noConsole --skip=correctness/noNodejsModules --skip=style/noNonNullAssertion",
    "check": "biome check --only=a11y --only=complexity --only=correctness --only=nursery --only=performance --only=security --only=style --only=suspicious --skip=nursery/useExplicitType --skip=nursery/noTernary --skip=nursery/noJsxPropsBind --skip=style/noJsxLiterals --skip=style/useNamingConvention --skip=style/useFilenamingConvention --skip=style/useExportsLast --skip=style/useComponentExportOnlyModules --skip=style/noHeadElement --skip=performance/noImgElement --skip=correctness/useQwikValidLexicalScope --skip=suspicious/noReactSpecificProps --error-on-warnings --skip=suspicious/noConsole --skip=correctness/noNodejsModules --skip=style/noNonNullAssertion",
    "check:write": "biome check --write --unsafe --only=a11y --only=complexity --only=correctness --only=nursery --only=performance --only=security --only=style --only=suspicious --skip=nursery/useExplicitType --skip=nursery/noTernary --skip=nursery/noJsxPropsBind --skip=style/noJsxLiterals --skip=style/useNamingConvention --skip=style/useFilenamingConvention --skip=style/useExportsLast --skip=style/useComponentExportOnlyModules --skip=style/noHeadElement --skip=performance/noImgElement --skip=correctness/useQwikValidLexicalScope --skip=suspicious/noReactSpecificProps --skip=suspicious/noConsole --skip=correctness/noNodejsModules --skip=style/noNonNullAssertion",
    "verify": "bun run typecheck && bun run check",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:pull": "bunx --bun drizzle-kit pull",
    "db:studio": "bunx --bun drizzle-kit studio",
    "config:schema": "bun scripts/generate-source-config-schema.ts",
    "config:schema:check": "bun scripts/generate-source-config-schema.ts --check",
    "config:verify": "bun run config:schema:check && bun test src/server/ingest/config src/server/ingest/canonical.test.ts src/server/ingest/fetch src/server/ingest/core",
    "core:build": "bun scripts/build-core-dataset.ts",
    "ingest:run": "bun scripts/ingest-run.ts",
    "db:seed": "bun backend/store/seed.ts",
    "db:load-core": "bun scripts/load-core-to-store.ts",
    "db:refresh-sources": "bun run ingest:run && bun run db:load-core",
    "map:tiles": "bash frontend/scripts/fetch-poland-pmtiles.sh"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.19.0",
    "nitro": "^3.0.261103-rc",
    "pmtiles": "4.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@libsql/client": "^0.15.15",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.8"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
